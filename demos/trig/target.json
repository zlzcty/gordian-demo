  "cflags": [
    "-std=c11",
    "-fno-builtin",
    "-fno-strict-aliasing",
    "-ffp-contract=off",
    "-D__LITTLE_ENDIAN",
    "-Dsin=gordian_fdlibm_sin",
    "-Dcos=gordian_fdlibm_cos",
    "-D__kernel_sin=gordian_fdlibm___kernel_sin",
    "-D__kernel_cos=gordian_fdlibm___kernel_cos",
    "-D__ieee754_rem_pio2=gordian_fdlibm___ieee754_rem_pio2",
    "-D__kernel_rem_pio2=gordian_fdlibm___kernel_rem_pio2",
